NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3307
DB_USER=ecommerce
DB_PASSWORD=ecommerce
DB_NAME=ecommerce

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars
JWT_EXPIRES_IN=1h

# Cache TTL for product endpoints (seconds)
CACHE_TTL_SECONDS=60

# Seed admin user (npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!
